{
  "name": "accuminds-website",
  "private": true,
  "description": "AccuMinds Consulting FZCO website. Static: no build step to deploy. Dev-only: esbuild bundles the 3D hero (three.js).",
  "scripts": {
    "serve": "node tools/serve.mjs 4173",
    "check:todo": "node tools/check-todo.mjs",
    "images": "python tools/optimise_images.py",
    "build:3d": "esbuild assets/js/story/scene.js --bundle --minify --format=esm --target=es2020 --outfile=assets/js/story.bundle.js",
    "poster:3d": "node tools/story-poster.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
